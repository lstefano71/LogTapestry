# .gitignore for .NET projects (Visual Studio + VS Code)
# Build results
[Dd]ebug*/
[Rr]elease*/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Ww][Ii][Nn]32/
[Ww][Ii][Nn]64/
build/
[Bb]in/
[Oo]bj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.pidb
*.psess
*.vsp
*.vspx
*.vspscc
*.vssscc
*.cache
*.dbmdl
*.dbproj.schemaview
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# VS Code settings
.vscode/

# Visual Studio files
.vs/

# NuGet packages
*.nupkg
# The packages folder can be ignored if it is not under source control
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# DotCover
*.dotCover

# Rider
.idea/
*.sln.iml

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# NCrunch
*.ncrunch*
.*crunch*

# Resharper
*_ReSharper*/
*.[Rr]e[Ss]harper*
*.DotSettings.user

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.ipdb
*.tlog
*.log
*.vspscc
*.vssscc
*.scc

# Others
*.sln.docstates
*.orig
*.sdf
*.cache
*.dbmdl
*.bak
*.swp
*.tmp
*.diff
*.patch
*.orig
*.rej
*.swo
*.swn

# OS generated files
.DS_Store
Thumbs.db
/data
/state.sqlite
/logs
/sample-logs/*.txt
/bak
